# Copy to .env for local runs. On Render, set these in the dashboard instead.

# --- required in production ---------------------------------------------
# Long random string (Render generates it from render.yaml).
SECRET_KEY=
# PostgreSQL URL. Empty = local SQLite file in ./data (fine for development).
# Supabase: Project Settings → Database → Connection string → "Session pooler".
DATABASE_URL=

# --- PDF files in the cloud (optional) ----------------------------------
# Supabase: Project Settings → API → Project URL and the service_role key.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=books
MAX_FILE_MB=50
# auto | local | supabase | none   (auto: supabase if configured, otherwise local disk; none on Render)
FILE_STORAGE=auto

# --- Telegram bot (optional) --------------------------------------------
# New token from @BotFather. Never reuse a token that was ever written in code.
TELEGRAM_BOT_TOKEN=
# auto = webhook when PUBLIC_URL is https, otherwise off. Use "polling" to test the bot locally.
TELEGRAM_MODE=auto
# Public https address. On Render this is detected automatically (RENDER_EXTERNAL_URL).
PUBLIC_URL=

# --- background jobs ----------------------------------------------------
# Morning digest + deadline reminders run inside the app every minute.
SCHEDULER_ENABLED=true
# Optional: lets an external cron call /api/cron/tick?key=... to trigger reminders.
CRON_SECRET=

# Shown on /privacy (required by Google Play).
CONTACT_EMAIL=

# --- Google Play (Trusted Web Activity) ---------------------------------
# Package name chosen in PWABuilder, e.g. uz.makon.app
ANDROID_PACKAGE=
# SHA-256 fingerprints, comma-separated: the upload key (PWABuilder) AND the
# "App signing key" from Play Console → Test and release → App integrity.
ANDROID_SHA256=

# Comma-separated origins, only if the website is hosted on a different domain than the API.
CORS_ORIGINS=

# --- client IP for rate limiting -----------------------------------------
# X-Forwarded-For can be forged, so it is read only from the right.
# Render: leave empty (True-Client-IP from Cloudflare is used automatically).
# Behind one other proxy (Koyeb, Fly.io, nginx): TRUSTED_PROXY_HOPS=1
CLIENT_IP_HEADER=
TRUSTED_PROXY_HOPS=

# --- pictures and weather -------------------------------------------------
# Profile photo, home background and book covers are resized on the phone and kept in the database.
MAX_IMAGE_KB=1536
MAX_IMAGES_PER_USER=400
# Weather widget (Open-Meteo, free, no key). false = hide it.
WEATHER_ENABLED=true
